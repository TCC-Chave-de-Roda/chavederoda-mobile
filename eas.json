{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "android": {
        "developmentClient": true,
        "distribution": "internal"
      }
    },
    "preview": {
      "android": {
        "distribution": "internal"
      }
    },
    "production": {
      "android": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "production"
      }
    }
  }
}
